using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Net.WebSockets;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using System.Threading.Tasks;

namespace TaekwondoScoreboard
{
    public sealed class ScoreServer_BACKUP : IDisposable
    {
        private readonly HttpListener listener = new HttpListener();
        private readonly object sync = new object();

        private readonly Dictionary<int, WebSocket> judges =
            new Dictionary<int, WebSocket>();

        private readonly List<JudgeAction> pending =
            new List<JudgeAction>();

        private CancellationTokenSource cts;
        private Thread listenThread;

        public event Action<string> Log;
        public event Action<ScoreState> StateChanged;

        public string Judge1Token { get; private set; }
        public string Judge2Token { get; private set; }

        public bool IsRunning { get; private set; }

        private int CurrentBlue;
        private int CurrentRed;
        private int CurrentRound = 1;
        private int CurrentBlueRounds;
        private int CurrentRedRounds;
        private int CurrentSeconds = 120;
        private bool CurrentActive;

        public ScoreServer_BACKUP()
        {
            Judge1Token = Guid.NewGuid().ToString("N");
            Judge2Token = Guid.NewGuid().ToString("N");
        }

        // =========================================================
        // INICIAR SERVIDOR
        // =========================================================

        public void Start(int port = 8080)
        {
            if (IsRunning)
                return;

            listener.Prefixes.Add("http://*:" + port + "/");

            cts = new CancellationTokenSource();

            try
            {
                listener.Start();

                IsRunning = true;

                listenThread = new Thread(ListenLoop);
                listenThread.IsBackground = true;
                listenThread.Start();

                WriteLog("Servidor iniciado en puerto " + port);
            }
            catch (Exception ex)
            {
                IsRunning = false;

                WriteLog("Error al iniciar servidor: " + ex.Message);

                throw;
            }
        }

        // =========================================================
        // ESCUCHAR PETICIONES
        // =========================================================

        private void ListenLoop()
        {
            while (IsRunning && !cts.IsCancellationRequested)
            {
                try
                {
                    HttpListenerContext context =
                        listener.GetContext();

                    ThreadPool.QueueUserWorkItem(
                        delegate
                        {
                            HandleRequest(context);
                        });
                }
                catch
                {
                    if (IsRunning)
                    {
                        // El servidor sigue intentando escuchar.
                    }
                }
            }
        }

        // =========================================================
        // PETICIONES HTTP
        // =========================================================

        private void HandleRequest(HttpListenerContext context)
        {
            try
            {
                string path =
                    context.Request.Url.AbsolutePath
                    .Trim('/')
                    .ToLowerInvariant();

                if (path == "ws")
                {
                    HandleWebSocket(context);
                    return;
                }

                if (path == "" || path == "juez.html")
                {
                    ServeFile(
                        context,
                        "juez.html",
                        "text/html; charset=utf-8");

                    return;
                }

                if (path == "juez.css")
                {
                    ServeFile(
                        context,
                        "juez.css",
                        "text/css; charset=utf-8");

                    return;
                }

                if (path == "juez.js")
                {
                    ServeFile(
                        context,
                        "juez.js",
                        "application/javascript; charset=utf-8");

                    return;
                }

                context.Response.StatusCode = 404;
                context.Response.Close();
            }
            catch (Exception ex)
            {
                WriteLog("Error HTTP: " + ex.Message);

                try
                {
                    context.Response.Close();
                }
                catch
                {
                }
            }
        }

        // =========================================================
        // ENVIAR ARCHIVOS HTML / CSS / JS
        // =========================================================

        private void ServeFile(
            HttpListenerContext context,
            string fileName,
            string contentType)
        {
            string baseDir =
                AppDomain.CurrentDomain.BaseDirectory;

            string filePath =
                Path.Combine(
                    baseDir,
                    "wwwroot",
                    fileName);

            if (!File.Exists(filePath))
            {
                context.Response.StatusCode = 404;
                context.Response.Close();
                return;
            }

            byte[] data = File.ReadAllBytes(filePath);

            context.Response.ContentType = contentType;
            context.Response.ContentLength64 = data.Length;

            context.Response.OutputStream.Write(
                data,
                0,
                data.Length);

            context.Response.Close();
        }

        // =========================================================
        // WEBSOCKET
        // =========================================================

        private void HandleWebSocket(HttpListenerContext context)
        {
            Task.Run(async delegate
            {
                WebSocket socket = null;
                int role = 0;

                try
                {
                    if (!context.Request.IsWebSocketRequest)
                    {
                        context.Response.StatusCode = 400;
                        context.Response.Close();
                        return;
                    }

                    HttpListenerWebSocketContext wsContext =
                        await context.AcceptWebSocketAsync(null);

                    socket = wsContext.WebSocket;

                    // El primer mensaje debe ser HELLO
                    string helloText =
                        await ReceiveText(socket);

                    string token =
                        ObtenerValorJson(
                            helloText,
                            "token");

                    role = GetRoleByToken(token);

                    if (role == 0)
                    {
                        await Send(
                            socket,
                            "{\"type\":\"error\",\"message\":\"Token invalido.\"}");

                        await socket.CloseAsync(
                            WebSocketCloseStatus.PolicyViolation,
                            "Token invalido",
                            CancellationToken.None);

                        return;
                    }

                    lock (sync)
                    {
                        if (judges.ContainsKey(role))
                        {
                            try
                            {
                                judges[role].Abort();
                            }
                            catch
                            {
                            }

                            judges.Remove(role);
                        }

                        judges[role] = socket;
                    }

                    WriteLog(
                        "Juez " +
                        role +
                        " conectado.");

                    await SendState(socket);

                    while (
                        socket.State ==
                        WebSocketState.Open &&
                        IsRunning)
                    {
                        string text =
                            await ReceiveText(socket);

                        if (text == null)
                            break;

                        ProcessMessage(
                            role,
                            text);
                    }
                }
                catch (Exception ex)
                {
                    WriteLog(
                        "Conexion juez " +
                        role +
                        ": " +
                        ex.Message);
                }
                finally
                {
                    if (socket != null)
                    {
                        lock (sync)
                        {
                            if (
                                judges.ContainsKey(role) &&
                                Object.ReferenceEquals(
                                    judges[role],
                                    socket))
                            {
                                judges.Remove(role);
                            }
                        }
                    }

                    if (role != 0)
                    {
                        WriteLog(
                            "Juez " +
                            role +
                            " desconectado.");
                    }
                }
            });
        }

        // =========================================================
        // IDENTIFICAR JUEZ
        // =========================================================

        private int GetRoleByToken(string token)
        {
            if (token == Judge1Token)
                return 1;

            if (token == Judge2Token)
                return 2;

            return 0;
        }

        // =========================================================
        // PROCESAR MENSAJES
        // =========================================================

        private void ProcessMessage(
            int judge,
            string text)
        {
            try
            {
                string type =
                    ObtenerValorJson(
                        text,
                        "type");

                if (type != "action")
                    return;

                string side =
                    ObtenerValorJson(
                        text,
                        "side");

                string actionName =
                    ObtenerValorJson(
                        text,
                        "action");

                ActionType action;

                if (!Enum.TryParse(
                    actionName,
                    true,
                    out action))
                {
                    return;
                }

                if (
                    side != "AZUL" &&
                    side != "ROJO")
                {
                    return;
                }

                RegisterAction(
                    judge,
                    side,
                    action);
            }
            catch (Exception ex)
            {
                WriteLog(
                    "Mensaje invalido: " +
                    ex.Message);
            }
        }

        // =========================================================
        // LEER VALOR SIMPLE DE JSON
        // =========================================================

        private string ObtenerValorJson(
            string json,
            string propiedad)
        {
            if (String.IsNullOrEmpty(json))
                return "";

            string patron =
                "\"" +
                Regex.Escape(propiedad) +
                "\"\\s*:\\s*\"([^\"]*)\"";

            Match match =
                Regex.Match(
                    json,
                    patron,
                    RegexOptions.IgnoreCase);

            if (!match.Success)
                return "";

            return match.Groups[1].Value;
        }

        // =========================================================
        // REGISTRAR ACCION DE JUEZ
        // =========================================================

        public void RegisterAction(
            int judge,
            string side,
            ActionType action)
        {
            ScoreState newState;

            lock (sync)
            {
                if (!CurrentActive)
                    return;

                DateTime now =
                    DateTime.UtcNow;

                pending.RemoveAll(
                    delegate (JudgeAction x)
                    {
                        return
                            (now - x.TimeUtc)
                            .TotalMilliseconds > 1000;
                    });

                JudgeAction match =
                    pending.Find(
                        delegate (JudgeAction x)
                        {
                            return
                                x.Judge != judge &&
                                x.Side == side &&
                                x.Action == action &&
                                (now - x.TimeUtc)
                                .TotalMilliseconds <= 1000;
                        });

                if (match != null)
                {
                    pending.Remove(match);

                    ApplyPoint(
                        side,
                        action);
                }
                else
                {
                    pending.Add(
                        new JudgeAction
                        {
                            Judge = judge,
                            Side = side,
                            Action = action,
                            TimeUtc = now
                        });
                }

                newState = CurrentState();
            }

            PublishState(newState);
        }

        // =========================================================
        // APLICAR PUNTO
        // =========================================================

        private void ApplyPoint(
            string side,
            ActionType action)
        {
            int points = 0;

            switch (action)
            {
                case ActionType.Punch1:
                    points = 1;
                    break;

                case ActionType.Body2:
                    points = 2;
                    break;

                case ActionType.Head3:
                    points = 3;
                    break;

                case ActionType.SpinHead4:
                    points = 4;
                    break;

                case ActionType.KyongGo:
                    points = 1;
                    break;

                case ActionType.GamJeom:
                    points = 2;
                    break;
            }

            // La penalización de un competidor
            // da el punto al contrario.

            if (
                action == ActionType.KyongGo ||
                action == ActionType.GamJeom)
            {
                side =
                    side == "AZUL"
                    ? "ROJO"
                    : "AZUL";
            }

            if (side == "AZUL")
                CurrentBlue += points;
            else
                CurrentRed += points;
        }

        // =========================================================
        // ESTADO
        // =========================================================

        private ScoreState CurrentState()
        {
            return new ScoreState
            {
                Round = CurrentRound,
                BlueScore = CurrentBlue,
                RedScore = CurrentRed,

                BlueRounds =
                    CurrentBlueRounds,

                RedRounds =
                    CurrentRedRounds,

                SecondsRemaining =
                    CurrentSeconds,

                Status =
                    CurrentActive
                    ? "COMBATE ACTIVO"
                    : "ESPERANDO INICIO",

                MatchActive =
                    CurrentActive,

                Resting = false,

                GoldenPoint = false
            };
        }

        public ScoreState GetState()
        {
            lock (sync)
            {
                return CurrentState();
            }
        }

        // =========================================================
        // INICIAR COMBATE
        // =========================================================

        public void StartMatch()
        {
            lock (sync)
            {
                CurrentBlue = 0;
                CurrentRed = 0;

                CurrentRound = 1;

                CurrentBlueRounds = 0;
                CurrentRedRounds = 0;

                CurrentSeconds = 120;

                CurrentActive = true;

                pending.Clear();
            }

            PublishState(
                GetState());
        }

        // =========================================================
        // NUEVO COMBATE
        // =========================================================

        public void ResetMatch()
        {
            lock (sync)
            {
                CurrentBlue = 0;
                CurrentRed = 0;

                CurrentRound = 1;

                CurrentBlueRounds = 0;
                CurrentRedRounds = 0;

                CurrentSeconds = 120;

                CurrentActive = false;

                pending.Clear();
            }

            PublishState(
                GetState());
        }

        // =========================================================
        // RELOJ
        // =========================================================

        public void TickSecond()
        {
            ScoreState state;

            lock (sync)
            {
                if (!CurrentActive)
                    return;

                CurrentSeconds--;

                if (CurrentSeconds <= 0)
                {
                    CurrentSeconds = 0;

                    if (CurrentBlue > CurrentRed)
                    {
                        WinRound("AZUL");
                    }
                    else if (CurrentRed > CurrentBlue)
                    {
                        WinRound("ROJO");
                    }
                    else
                    {
                        CurrentActive = false;
                    }
                }

                state = CurrentState();
            }

            PublishState(state);
        }

        // =========================================================
        // DIFERENCIA DE 12
        // =========================================================

        public void CheckDifference()
        {
            ScoreState state;

            lock (sync)
            {
                if (!CurrentActive)
                    return;

                if (
                    Math.Abs(
                        CurrentBlue -
                        CurrentRed) >= 12)
                {
                    if (CurrentBlue > CurrentRed)
                        WinRound("AZUL");
                    else
                        WinRound("ROJO");
                }

                state = CurrentState();
            }

            PublishState(state);
        }

        // =========================================================
        // GANAR RONDA
        // =========================================================

        private void WinRound(
            string winner)
        {
            if (winner == "AZUL")
                CurrentBlueRounds++;
            else
                CurrentRedRounds++;

            // Si ya ganó 2 rondas,
            // termina el combate.

            if (
                CurrentBlueRounds >= 2 ||
                CurrentRedRounds >= 2)
            {
                CurrentActive = false;
                return;
            }

            // Siguiente ronda

            CurrentRound++;

            CurrentBlue = 0;
            CurrentRed = 0;

            CurrentSeconds = 120;

            pending.Clear();
        }

        // =========================================================
        // PUBLICAR ESTADO
        // =========================================================

        private void PublishState(
            ScoreState state)
        {
            if (StateChanged != null)
                StateChanged(state);

            _ = BroadcastState(state);
        }

        // =========================================================
        // ENVIAR ESTADO A CELULARES
        // =========================================================

        private async Task BroadcastState(
            ScoreState state)
        {
            string text =
                CrearJsonEstado(state);

            List<WebSocket> sockets;

            lock (sync)
            {
                sockets =
                    new List<WebSocket>(
                        judges.Values);
            }

            foreach (WebSocket socket in sockets)
            {
                try
                {
                    if (
                        socket.State ==
                        WebSocketState.Open)
                    {
                        await Send(
                            socket,
                            text);
                    }
                }
                catch
                {
                }
            }
        }

        private async Task SendState(
            WebSocket socket)
        {
            ScoreState state =
                GetState();

            await Send(
                socket,
                CrearJsonEstado(state));
        }

        // =========================================================
        // CREAR JSON
        // =========================================================

        private string CrearJsonEstado(
            ScoreState state)
        {
            return
                "{"
                + "\"type\":\"state\","
                + "\"round\":" + state.Round + ","
                + "\"blue\":" + state.BlueScore + ","
                + "\"red\":" + state.RedScore + ","
                + "\"blueRounds\":" + state.BlueRounds + ","
                + "\"redRounds\":" + state.RedRounds + ","
                + "\"seconds\":" + state.SecondsRemaining + ","
                + "\"active\":" + (state.MatchActive ? "true" : "false") + ","
                + "\"status\":\""
                + EscapeJson(state.Status)
                + "\""
                + "}";
        }

        private string EscapeJson(
            string text)
        {
            if (text == null)
                return "";

            return text
                .Replace("\\", "\\\\")
                .Replace("\"", "\\\"");
        }

        // =========================================================
        // ENVIAR WEBSOCKET
        // =========================================================

        private static async Task Send(
            WebSocket socket,
            string text)
        {
            byte[] bytes =
                Encoding.UTF8.GetBytes(text);

            await socket.SendAsync(
                new ArraySegment<byte>(bytes),
                WebSocketMessageType.Text,
                true,
                CancellationToken.None);
        }

        // =========================================================
        // RECIBIR WEBSOCKET
        // =========================================================

        private static async Task<string> ReceiveText(
            WebSocket socket)
        {
            byte[] buffer =
                new byte[4096];

            using (MemoryStream ms =
                new MemoryStream())
            {
                while (true)
                {
                    WebSocketReceiveResult result =
                        await socket.ReceiveAsync(
                            new ArraySegment<byte>(
                                buffer),
                            CancellationToken.None);

                    if (
                        result.MessageType ==
                        WebSocketMessageType.Close)
                    {
                        return null;
                    }

                    ms.Write(
                        buffer,
                        0,
                        result.Count);

                    if (result.EndOfMessage)
                    {
                        return Encoding.UTF8.GetString(
                            ms.ToArray());
                    }
                }
            }
        }

        // =========================================================
        // LOG
        // =========================================================

        private void WriteLog(
            string message)
        {
            if (Log != null)
            {
                Log(
                    DateTime.Now.ToString("HH:mm:ss")
                    + " - "
                    + message);
            }
        }

        // =========================================================
        // CERRAR SERVIDOR
        // =========================================================

        public void Dispose()
        {
            IsRunning = false;

            try
            {
                if (cts != null)
                    cts.Cancel();
            }
            catch
            {
            }

            try
            {
                listener.Stop();
            }
            catch
            {
            }

            try
            {
                listener.Close();
            }
            catch
            {
            }

            lock (sync)
            {
                foreach (
                    WebSocket socket
                    in judges.Values)
                {
                    try
                    {
                        socket.Abort();
                    }
                    catch
                    {
                    }
                }

                judges.Clear();
            }
        }
    }
}