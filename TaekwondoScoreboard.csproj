<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>

		<RootNamespace>TaekwondoScoreboard</RootNamespace>
		<AssemblyName>TaekwondoScoreboard</AssemblyName>

		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<Deterministic>true</Deterministic>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="QRCoder" Version="1.8.0" />
	</ItemGroup>


	<ItemGroup>

		<Content Include="wwwroot\juez.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="wwwroot\juez.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="wwwroot\juez.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="wwwroot\manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="wwwroot\sw.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>


	<ItemGroup>
	  <Reference Include="Windows">
	    <HintPath>..\..\..\..\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd</HintPath>
	    <IsWinMDFile>true</IsWinMDFile>
	  </Reference>
	</ItemGroup>

</Project>